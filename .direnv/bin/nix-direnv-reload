#!/usr/bin/env bash
set -e
if [[ ! -d "/Users/pcarrier/src/flower" ]]; then
  echo "Cannot find source directory; Did you move it?"
  echo "(Looking for "/Users/pcarrier/src/flower")"
  echo 'Cannot force reload with this script - use "direnv reload" manually and then try again'
  exit 1
fi

# rebuild the cache forcefully
_nix_direnv_force_reload=1 direnv exec "/Users/pcarrier/src/flower" true
