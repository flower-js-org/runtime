# shellcheck shell=bash
# Flower's own dev shell: its pinned Node.js and Rust toolchain, and process-compose.
use flake ../..
PATH_add bin

# Overrides and secrets (ANTHROPIC_API_KEY, TRINITY_SECRET_*) go in .env.local, which is not committed.
dotenv_if_exists .env.local

# Ports clear of Flower's own development node on 7101.
export TRINITY_FLOWER_PORT="${TRINITY_FLOWER_PORT:-7301}"
export TRINITY_PORT="${TRINITY_PORT:-8301}"

export FLOWER_DIR="${FLOWER_DIR:-$(cd ../.. && pwd)}"
export FLOWER_URL="${FLOWER_URL:-http://127.0.0.1:${TRINITY_FLOWER_PORT}}"
export TRINITY_URL="${TRINITY_URL:-http://127.0.0.1:${TRINITY_PORT}}"
export TRINITY_PUBLIC_URL="${TRINITY_PUBLIC_URL:-${TRINITY_URL}}"

# Development only: the node listens on 127.0.0.1, and anyone may sign in as anyone.
export FLOWER_ADMIN_TOKEN="${FLOWER_ADMIN_TOKEN:-trinity-local-development}"
export TRINITY_DEV_LOGIN="${TRINITY_DEV_LOGIN:-1}"

# Local state stays in .dev/: blobs, the CLI's tokens, and process-compose's control socket.
export TRINITY_BLOBS="${TRINITY_BLOBS:-file://${PWD}/.dev/blobs}"
export TRINITY_CONFIG="${TRINITY_CONFIG:-${PWD}/.dev/cli.json}"
export PC_SOCKET_PATH="${PC_SOCKET_PATH:-${PWD}/.dev/pc.sock}"
