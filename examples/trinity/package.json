{
  "name": "trinity",
  "private": true,
  "type": "module",
  "description": "An agent loop hosted in Flower",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "bin/dev",
    "deploy": "node scripts/deploy.ts",
    "gateway": "node gateway/main.ts",
    "build": "vite build web",
    "test": "node --test test/*.test.ts",
    "e2e": "node test/e2e.ts",
    "bench": "node bench/drive.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@flower-js/sdk": "file:../..",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "^3.0.0-next.44",
    "@solidjs/web": "^2.0.0-rc.9",
    "@types/node": "^26.6.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.47",
    "mermaid": "^12.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gemoji": "^8.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "solid-js": "^2.0.0-rc.9",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vite": "^8.3.1"
  },
  "bin": {
    "trinity": "bin/trinity"
  }
}
